APP_ENV=development
APP_NAME=ReCircle API
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://recircle_app:local_dev_password@localhost:5432/recircle
JWT_SECRET=replace-with-a-long-random-local-secret
ACCESS_TOKEN_MINUTES=60
FRONTEND_ORIGIN=http://localhost:3000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=replace-with-an-installed-model-name
OLLAMA_TIMEOUT_SECONDS=20

NEO4J_ENABLED=false
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
